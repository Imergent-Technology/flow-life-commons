# Local development settings read by Docker Compose. Copied to .env (gitignored)
# by `./flow setup`, which also fills in FLOW_UID / FLOW_GID from your Linux user.
# Contains no secrets; application settings live in apps/platform/.env.

# Container processes run as this user so files created in the repo stay yours.
FLOW_UID=1000
FLOW_GID=1000

# Host ports, bound to loopback by default. Deliberately non-standard (standard
# port with a "1" prefix) so this stack can run beside other dev environments.
# Change them if they clash with something on your machine.
FLOW_GATEWAY_PORT=18080
FLOW_DB_PORT=13306
FLOW_PG_PORT=15432
FLOW_REDIS_PORT=16379
FLOW_BIND_ADDRESS=127.0.0.1

# Vite uses native filesystem events. Set to true only if HMR does not fire
# in your environment (see docs/development/docker.md).
FLOW_VITE_POLLING=false
