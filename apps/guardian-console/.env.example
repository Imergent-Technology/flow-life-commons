# Guardian Console build/dev settings. Nothing here is secret: Vite embeds every
# VITE_* value in the public bundle. Never put credentials or tokens in VITE_* vars.
#
# Under ./flow the dev server receives this from compose.yaml; the value below is only
# needed if you run Vite some other way. Release builds set it explicitly per environment.
VITE_API_BASE_URL=http://api.flowlife.localhost:18080
