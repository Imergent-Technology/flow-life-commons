# Flow Life platform: LOCAL DEVELOPMENT settings.
#
# Copied to .env (gitignored) by `./flow setup`; APP_KEY is generated there.
# Every value below is a development placeholder. Production configuration is
# supplied on the host and is never committed (see docs/security/secrets.md).

APP_NAME="Flow Life Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.flowlife.localhost:18080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB service from compose.yaml. Credentials match compose.yaml (dev only).
# PostgreSQL portability runs override these (see ./flow test backend --pgsql).
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=flowlife
DB_USERNAME=flowlife
DB_PASSWORD=flowlife_dev_only

# Database-backed queue and cache; nothing requires Redis.
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mailpit (development mail catcher; UI at http://mail.flowlife.localhost:18080).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@flowlife.localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Browser origins allowed to call the API (comma-separated). The Guardian Console
# dev server runs on the gateway host below.
CORS_ALLOWED_ORIGINS=http://guardian.flowlife.localhost:18080
