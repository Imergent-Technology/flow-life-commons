# Flow Life platform: LOCAL DEVELOPMENT settings.
#
# Copied to .env (gitignored) by `./flow setup`; APP_KEY is generated there.
# Every value below is a development placeholder. Production configuration is
# supplied on the host and is never committed (see docs/security/secrets.md).

APP_NAME="Flow Life Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://commons.flowlife.localhost:18080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB service from compose.yaml. Credentials match compose.yaml (dev only).
# PostgreSQL portability runs override these (see ./flow test backend --pgsql).
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=flowlife
DB_USERNAME=flowlife
DB_PASSWORD=flowlife_dev_only

# Database-backed queue and cache; nothing requires Redis.
QUEUE_CONNECTION=database
CACHE_STORE=database
# Guardian Console sessions (ADR 0016): database-backed, 30 minutes of REQUEST inactivity.
# The 12-hour absolute lifetime and every cookie attribute are fixed in config, not here.
SESSION_DRIVER=database
SESSION_LIFETIME=30

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mailpit (development mail catcher; UI at http://mail.flowlife.localhost:18080).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@flowlife.localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Cross-origin browser access to the API. Deliberately EMPTY: the Guardian Console is
# served from the same origin as the API (ADR 0016) and needs no CORS. List an origin
# here (comma-separated) only for a legitimate external browser consumer, and never
# with credentials.
CORS_ALLOWED_ORIGINS=
