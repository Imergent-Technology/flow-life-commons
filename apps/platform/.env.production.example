# Flow Life Commons: PRODUCTION settings.
#
# This is a TEMPLATE. It holds no secret and never will: the values that are secret are left blank
# for the operator to supply on the host (see OPERATOR SUPPLIES below). Copy it to the host as
# `shared/.env`, fill in the blanks, and `chmod 600` it — that file is the only secret on the account
# and lives outside the document root and outside every release directory, reached by symlink
# (ADR 0027, docs/runbooks/deployment.md, first deployment step 3).
#
# This file is NOT shipped inside a release artifact, deliberately: the release validator refuses any
# `.env*` file in an artifact, because an environment file in a built package is a secret waiting for
# somewhere to leak. It is repository documentation for the person doing the deployment.
#
# DO NOT start from `.env.example`. That is the development file, and its two most dangerous values —
# `APP_DEBUG=true` and `IDENTITY_COMPROMISED_PASSWORD_CHECK=none` — are exactly the ones that must
# never reach production. This file exists so that copying the right one is easier than copying the
# wrong one.
#
# After filling it in, run `php artisan security:production-check` on the host. It reads the
# configuration this file produces and refuses the dangerous values; a green result is required before
# serving real people, and it is not a statement about the hosting account (that list is printed with
# the results, and lives in docs/runbooks/production-readiness.md).

# ---------------------------------------------------------------------------
# OPERATOR SUPPLIES: four values, none of which may be committed anywhere.
#
#   APP_KEY        `php artisan key:generate --show` on the host, pasted below.
#                  RECORD IT, with today's date, in the owner's secure secret store. Every database
#                  backup from now on is only restorable alongside the keyring that produced it: every
#                  enrolled authenticator is ciphertext under this key (ADR 0023), and a dump restored
#                  under a different one leaves every second factor intact and permanently unreadable
#                  (docs/runbooks/backup-and-restore.md).
#   DB_*           from cPanel's MySQL Databases screen. cPanel prefixes both the database and the
#                  user with the account name, so the values are not the ones you typed when creating
#                  them — copy what cPanel shows.
# ---------------------------------------------------------------------------

APP_NAME="Flow Life Commons"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# The one origin serving both the Guardian Console and the API (ADR 0016). It is the origin of every
# invitation and password-reset link, and the only Host header the application will answer to. It must
# be https:// — over http:// the `__Host-` session cookie cannot be issued at all and nobody can sign
# in — and it must name the host root with no path.
APP_URL=https://commons.flowlifeglobal.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# `file`, and not `cache`, is load-bearing. `php artisan down` writes `storage/framework/down`, and
# BOTH halves of the origin observe that one file: Laravel for `/api/*` and `/up`, and Apache's
# `.htaccess` for the Console and its assets, through the shared storage symlink. Under the `cache`
# driver the flag is a database row instead, the file is never written, and the static half of the
# site keeps serving happily while the API is down (ADR 0027, deployment runbook section 4).
APP_MAINTENANCE_DRIVER=file

# Password hashing cost. The test suite runs at 4 for speed; production must not.
BCRYPT_ROUNDS=12

# Logs go to `shared/storage/logs`, which survives the release switch. `debug` would write request
# detail about signed-in people to a file that is backed up and kept.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MariaDB on the hosting account (measured: 10.11, matching development). Local socket/loopback only;
# this database is not reachable from outside the account and must not be made so.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Database-backed, because the hosting account runs no Redis, no memcached and no resident daemon of
# any kind (charter). The queue is drained from the scheduler tick; there is no worker process, and no
# application class dispatches queued work yet (ADR 0010, ADR 0027).
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Guardian Console sessions (ADR 0016): a session must be revocable, so it is a database row rather
# than a cookie or a file. 30 minutes of request inactivity; the 12-hour absolute lifetime and every
# cookie attribute (`__Host-` prefix, Secure, HttpOnly, SameSite=Lax, no Domain) are fixed in
# config/session.php and are deliberately NOT settable here.
SESSION_DRIVER=database
SESSION_LIFETIME=30

# ---------------------------------------------------------------------------
# OUTBOUND MAIL: OPEN AND DEFERRED. Do not treat the values below as a configuration.
#
# Flow Life's mail topology is an organizational decision that has not been made, so nothing here
# sends anything. `log` is chosen deliberately over an SMTP transport that has not been agreed and
# over PHP's `mail()`, which is NOT approved: it was tested on the host on 2026-09-21, it delivered,
# and it delivered UNSIGNED and not DMARC-aligned (SPF passed only for the hosting account's own
# envelope sender; there was no DKIM signature). A transport that lands invitations in spam is an
# outage that looks like nothing at all, and this is an invite-only directory where the invitation
# email IS the way in.
#
# With `log`, an invitation is written to the application log instead of being sent. That is a safe
# deferral, not a working configuration: the first administrator's invitation token is delivered out
# of band over SSH during the bootstrap ceremony (docs/runbooks/administrator-bootstrap.md), which is
# why deployment is not blocked by this — but nobody else can be invited until it is settled.
#
# Before this is a real configuration: choose the transport, then verify SPF alignment for the ACTUAL
# envelope sender, DKIM signing, DMARC pass, a real invitation sent through the application, and
# inbox rather than spam placement. Record the result in docs/runbooks/production-readiness.md
# section 5. `security:production-check` reports this as an open item until then, and refuses
# `mail`/`sendmail` outright.
# ---------------------------------------------------------------------------

MAIL_MAILER=log
MAIL_FROM_ADDRESS="commons@flowlifeglobal.org"
MAIL_FROM_NAME="${APP_NAME}"

# Cross-origin browser access to the API. Deliberately EMPTY and expected to stay so: the Console is
# served from the same origin as the API (ADR 0016), so no browser client is cross-origin. A value
# here would mean some browser somewhere needs the API cross-origin, which the session design says
# nothing should.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# DELIBERATELY ABSENT — do not add these.
#
#   IDENTITY_COMPROMISED_PASSWORD_CHECK   The development file sets `none`, which accepts known-
#                                         breached passwords. Unset, the application uses the real
#                                         Pwned Passwords range API (k-anonymity: five hash characters
#                                         leave the host, and an outage refuses a password rather than
#                                         accepting it). It needs outbound HTTPS, verified on 2026-09-21.
#   IDENTITY_LOGIN_MAX_ATTEMPTS_PER_IP    The browser suite raises this to 200. Unset, production
#                                         keeps 30 per address per 15 minutes.
#   TRUSTED_PROXIES                       Not a setting this application reads, at all. Commons is
#                                         direct to origin and trusts no proxy: every per-address rate
#                                         limit and every audit row depends on the client address
#                                         being real. Putting Commons behind a CDN or WAF later is a
#                                         reviewed code change listing explicit ranges — never a
#                                         wildcard, and never an environment variable
#                                         (docs/architecture/trust-boundaries.md).
# ---------------------------------------------------------------------------
